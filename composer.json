{
    "name": "shanginn/cloudflare-browser",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Shanginn\\CloudflareBrowser\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "require": {
        "php": ">=8.2",
        "symfony/serializer": "^8",
        "crell/serde": "^1.3",
        "amphp/http-client": "^5.3",
        "spiral/json-schema-generator": "^1.1",
        "symfony/property-access": "^8"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "mockery/mockery": "^1.6",
        "symfony/var-dumper": "^8.0"
    }
}
